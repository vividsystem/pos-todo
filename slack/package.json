{
  "name": "pos-todo-slackbot",
  "version": "1.0.0",
  "description": "A slackapp for pos-todo",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
		"start:prod": "node ./dist/app.js"
    "start": "bun run build && node ./dist/app.js",
    "lint": "bunx @biomejs/biome check *.ts listeners tests",
    "lint:fix": "bunx @biomejs/biome check --write *.ts listeners tests",
    "test": "bun run build && bun run lint && node --import tsx --test"
  },
  "author": "vividsystem",
  "license": "MIT",
  "keywords": [
    "slack",
    "bolt",
    "slackapi",
    "typescript"
  ],
  "dependencies": {
    "@slack/bolt": "^4.5.0",
    "dotenv": "~17.2.3",
    "mqtt": "^5.14.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@slack/cli-hooks": "^1.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
